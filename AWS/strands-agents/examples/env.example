# Prisma AIRS credentials -- from Strata Cloud Manager (Insights > AI Runtime Security)
PRISMA_AIRS_API_KEY=your-api-key-here
PRISMA_AIRS_PROFILE_NAME=your-security-profile-name

# Optional: regional endpoint (defaults to US)
# PRISMA_AIRS_URL=https://service.api.eu.aisecurity.paloaltonetworks.com

# Optional: model id used by the example
# BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
